+def _lifecycle(payload: dict, *, assistant: bool = False) -> tuple[bool, bool]:
+    """Return explicit activity/completion; missing fields prove neither."""
+    metadata = payload.get("metadata") if isinstance(payload.get("metadata"), dict) else {}
+    status = str(payload.get("status") or payload.get("state") or "").lower()
+    if metadata.get("streaming") is True or payload.get("streaming") is True:
+        return True, False
+    if status in {"running", "streaming", "pending", "queued", "in_progress", "started", "executing"}:
+        return True, False
+    if status in {"completed", "done", "succeeded", "success", "failed", "error", "cancelled", "canceled"}:
+        return False, True
+    # Explicit false is an assistant-text boundary, not a whole tool/turn
+    # completion. Missing metadata remains unknown.
+    if assistant and (metadata.get("streaming") is False or payload.get("streaming") is False):
+        return False, True
+    return False, payload.get("completed") is True or payload.get("done") is True
+
+
+def _turn_lifecycle(events: list[dict]) -> tuple[bool, bool, bool]:
+    """Track the latest assistant and independent tool lifecycles in order."""
+    active: dict[str, bool] = {}
+    assistant_active = assistant_done = turn_done = False
+    for event in events:
+        name = str(event.get("event_name") or event.get("event") or "")
+        payload = event.get("payload") if isinstance(event.get("payload"), dict) else {}
+        if name in {"turn.completed", "turn.failed", "turn.cancelled", "turn.canceled"}:
+            active.clear()
+            assistant_active, turn_done = False, True
+            continue
+        if name == "message.assistant":
+            if event.get("reply_to_message_id") or payload.get("reply_to_message_id"):
+                continue
+            assistant_active, assistant_done = _lifecycle(payload, assistant=True)
+            # Even an empty replacement assistant supersedes the old reply.
+            turn_done = False
+            continue
+        if name in {"message.done", "delta.message_done"}:
+            # A message boundary is weaker than an active assistant/tool.
+            if not assistant_active:
+                assistant_done = True
+            continue
+        busy, done = _lifecycle(payload)
+        if not busy and not done:
+            continue
+        identity = (payload.get("tool_call_id") or payload.get("call_id")
+                    or payload.get("id") or event.get("message_id") or name)
+        active[str(identity)] = busy
+        if busy:
+            turn_done = False
+    return assistant_active or any(active.values()), assistant_done, turn_done
 
 
